// Deploy once with `npx wrangler deploy` from this folder. It does not change
// with the website, so the website's workflow does not deploy it.
{
  "name": "rtlawservices-www",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "www.rtlawservices.com/*", "zone_name": "rtlawservices.com" }]
}
