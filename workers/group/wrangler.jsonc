// group.rtlawservices.com: a static site for the firm's four businesses.
// Build with `node src/build.mjs`, then deploy with `npx wrangler deploy`
// from this folder. The workflow .github/workflows/group.yml does both.
{
  "name": "rtlawservices-group",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "group.rtlawservices.com", "custom_domain": true }]
}
