rules_version = '2';

// Default deny. Public visitors may only create bookings, slot locks and
// messages, and may never read them back. Staff access requires a document
// at /staff/{uid}, which only project owners can create (console or Admin SDK).
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function isOwner() {
      return isStaff()
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'owner';
    }

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function inBookingWindow(t) {
      return t is timestamp
        && t > request.time
        && t < request.time + duration.value(35, 'd');
    }

    // Slot locks carry no personal data, so anyone may read them to grey out
    // taken times. A slot can be created once and never overwritten, which
    // prevents double booking. Each lock must name a booking written in the
    // same batch for the same attorney, so times cannot be locked without a
    // request that staff can see and remove.
    match /slots/{slotId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['attorney', 'day', 'start', 'bookingId', 'createdAt'])
        && str(request.resource.data.attorney, 1, 64)
        && slotId.matches('^' + request.resource.data.attorney + '_.+')
        && str(request.resource.data.day, 10, 10)
        && inBookingWindow(request.resource.data.start)
        && str(request.resource.data.bookingId, 10, 64)
        && existsAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.attorney == request.resource.data.attorney
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isStaff();
    }

    match /bookings/{bookingId} {
      allow create: if request.resource.data.keys().hasOnly([
            'matter', 'matterLabel', 'mode', 'attorney', 'start', 'day', 'durationMin', 'visitorTz',
            'name', 'email', 'phone', 'country', 'language', 'otherParties', 'notes', 'source',
            'consents', 'slotId', 'status', 'createdAt'])
        && str(request.resource.data.matter, 1, 64)
        && str(request.resource.data.matterLabel, 1, 120)
        && request.resource.data.mode in ['video', 'phone', 'office']
        && str(request.resource.data.attorney, 1, 64)
        && inBookingWindow(request.resource.data.start)
        && request.resource.data.durationMin in [30, 60]
        && str(request.resource.data.visitorTz, 1, 64)
        && str(request.resource.data.name, 2, 200)
        && str(request.resource.data.email, 5, 200)
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')
        && str(request.resource.data.phone, 7, 200)
        && str(request.resource.data.country, 1, 200)
        && str(request.resource.data.language, 0, 200)
        && str(request.resource.data.otherParties, 0, 200)
        && str(request.resource.data.notes, 0, 1200)
        && str(request.resource.data.source, 0, 200)
        && request.resource.data.consents == {'noRelationship': true, 'privacy': true}
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        // The matching slot lock must be new and written in the same batch,
        // and it must point back at this booking.
        && str(request.resource.data.slotId, 10, 120)
        && str(request.resource.data.day, 10, 10)
        && !exists(/databases/$(database)/documents/slots/$(request.resource.data.slotId))
        && existsAfter(/databases/$(database)/documents/slots/$(request.resource.data.slotId))
        && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.slotId)).data.start == request.resource.data.start
        && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.slotId)).data.bookingId == bookingId;
      allow read: if isStaff();
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy', 'staffNote']);
      allow delete: if isOwner();
    }

    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'topic', 'message', 'status', 'createdAt'])
        && str(request.resource.data.name, 2, 120)
        && str(request.resource.data.email, 5, 160)
        && str(request.resource.data.phone, 0, 40)
        && str(request.resource.data.topic, 1, 60)
        && str(request.resource.data.message, 10, 2000)
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read: if isStaff();
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy', 'staffNote']);
      allow delete: if isOwner();
    }

    // Free evaluation requests. A CV, when attached, is split into base64
    // chunks in the files subcollection, written in the same batch.
    match /evaluations/{evaluationId} {
      allow create: if request.resource.data.keys().hasOnly([
            'name', 'email', 'phone', 'birthCountry', 'track', 'answers', 'file', 'consents', 'status', 'createdAt'])
        && str(request.resource.data.name, 2, 200)
        && str(request.resource.data.email, 5, 200)
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')
        && str(request.resource.data.phone, 7, 60)
        && str(request.resource.data.birthCountry, 1, 80)
        && request.resource.data.track in ['professional', 'family']
        && request.resource.data.answers is map
        && request.resource.data.answers.size() <= 40
        && (request.resource.data.file == null
            || (request.resource.data.file is map
                && request.resource.data.file.chunks is int
                && request.resource.data.file.chunks >= 1
                && request.resource.data.file.chunks <= 6))
        && request.resource.data.consents == {'noRelationship': true, 'accurate': true}
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read: if isStaff();
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy', 'staffNote']);
      allow delete: if isOwner();

      match /files/{chunkId} {
        allow create: if existsAfter(/databases/$(database)/documents/evaluations/$(evaluationId))
          && getAfter(/databases/$(database)/documents/evaluations/$(evaluationId)).data.file != null
          && int(chunkId) >= 0 && int(chunkId) < 6
          && request.resource.data.keys().hasOnly(['index', 'data'])
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 800000;
        allow read: if isStaff();
        allow delete: if isOwner();
      }
    }

    // Website content managed in the back office. Published records are public.
    match /attorneys/{id} {
      allow read: if resource.data.status == 'published' || isStaff();
      allow write: if isStaff();
    }
    match /cases/{id} {
      allow read: if resource.data.status == 'published' || isStaff();
      allow write: if isStaff();
    }
    match /reviews/{id} {
      allow read: if resource.data.status == 'published' || isStaff();
      allow write: if isStaff();
    }
    match /posts/{id} {
      allow read: if resource.data.status == 'published' || isStaff();
      allow write: if isStaff();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    // The published content the public website reads on each page view,
    // rewritten by the back office after every save.
    match /public/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /meta/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Back-office secrets, such as the token that starts a website build.
    // Staff read it to publish; only owners may change it.
    match /private/{id} {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    match /staff/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isStaff());
      allow write: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
